{
  "name": "greyok-ui-framework",
  "version": "0.5.2",
  "description": "greyok-ui-framework - 20 swappable themes, 20 layout archetypes, 63 elements, 6 size buckets. Works in HTML/CSS, Tkinter (Python bridge), and TypeScript. Drop in tokens, theme, layouts and element CSS, pick a theme, ship.",
  "type": "module",
  "main": "elements.js",
  "exports": {
    ".": "./elements.js",
    "./charts.js": "./charts.js",
    "./tokens.css": "./tokens.css",
    "./themes.css": "./themes.css",
    "./layouts.css": "./layouts.css",
    "./base.css": "./base.css",
    "./elements-display.css": "./elements-display.css",
    "./elements-lists.css": "./elements-lists.css",
    "./elements-controls.css": "./elements-controls.css",
    "./elements-dataviz.css": "./elements-dataviz.css",
    "./elements-containers.css": "./elements-containers.css",
    "./elements-inputs.css": "./elements-inputs.css",
    "./elements-interactions.css": "./elements-interactions.css",
    "./elements-misc.css": "./elements-misc.css",
    "./elements-size.css": "./elements-size.css",
    "./theme-switcher.js": "./theme-switcher.js",
    "./python": "./python/greyok_ui_framework.py",
    "./typescript": "./typescript/elements.d.ts"
  },
  "files": [
    "*.css",
    "*.js",
    "LICENSE",
    "README.md",
    "assets/",
    "demo/",
    "python/",
    "typescript/"
  ],
  "scripts": {
    "demo": "python3 -m http.server 8768 --bind 127.0.0.1",
    "verify": "bash bin/verify.sh"
  },
  "keywords": [
    "ui-framework",
    "css-framework",
    "design-system",
    "themes",
    "tkinter",
    "typescript",
    "greyok"
  ],
  "author": "greyok00",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greyok00/greyok-ui-framework.git"
  }
}
